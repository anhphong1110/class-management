# Sao thành .env.bootstrap.local (đã được gitignore) rồi điền giá trị thật. Không commit file có giá trị thật.

# --- 4 biến đặt cả trên Vercel và khi chạy `pnpm bootstrap:prod` ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Phải giống hệt giá trị trên Vercel.
AUTH_EMAIL_DOMAIN=tram58.local

# --- Chỉ dùng cho `pnpm bootstrap:prod` (không đặt lên Vercel) ---
SCHOOL_NAME=Tên trường
CLASS_NAME=Tên lớp
SCHOOL_YEAR=2026 – 2027
TEACHER_NAME=Tên giáo viên
TEACHER_USERNAME=co.ten
TEACHER_PASSWORD=mat-khau-toi-thieu-8-ky-tu

# Ngày học kỳ, tùy chọn, dạng YYYY-MM-DD. Bỏ trống thì đặt sau trong Cài đặt.
TERM1_START=
TERM1_END=
TERM2_START=
TERM2_END=
